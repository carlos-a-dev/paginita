{
  "kind": "collectionType",
  "collectionName": "contact_messages",
  "info": {
    "singularName": "contact-message",
    "pluralName": "contact-messages",
    "displayName": "ContactMessage"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "email": {
      "type": "email",
      "required": true,
      "maxLength": 254
    },
    "phone": {
      "type": "string",
      "maxLength": 50
    },
    "message": {
      "type": "string",
      "required": true,
      "minLength": 21,
      "maxLength": 500
    },
    "sent": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "ip": {
      "type": "string"
    }
  }
}
