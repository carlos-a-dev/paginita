NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Comma-separated HTTP(S) origins permitted by the production CSP.
# Defaults match the font stylesheet currently configured in nuxt.config.ts.
NUXT_SECURITY_STYLE_ORIGINS=https://fonts.googleapis.com
NUXT_SECURITY_FONT_ORIGINS=https://fonts.gstatic.com
NUXT_SECURITY_IMAGE_ORIGINS=
NUXT_SECURITY_CONNECT_ORIGINS=
